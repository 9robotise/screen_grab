<?xml version="1.0"?>
<package format="2">
  <name>screen_grab</name>
  <version>0.1.0</version>
  <description>Pure Python ROS package to capture screen images and publish as sensor_msgs/Image</description>

  <maintainer email="lucasw_backwards@gmail.com">Lucas Walter</maintainer>
  <license>BSD</license>

  <url type="website">https://github.com/lucasw/screen_grab</url>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>dynamic_reconfigure</build_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>rospy</build_depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>dynamic_reconfigure</exec_depend>

  <export>
  </export>
</package>
